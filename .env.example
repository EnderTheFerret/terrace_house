MODE=real            # real | mock
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
# Optional roleplay model for speaking lines only; empty uses OLLAMA_MODEL (one model = one reload after images). See docs/ROLEPLAY.md.
OLLAMA_MODEL_LINES=
# Empty: keep one model for 30m; unload after each request when two models are selected.
OLLAMA_KEEP_ALIVE=30m
COMFY_URL=http://127.0.0.1:8188
COMFY_WORKFLOW=./workflows/txt2img.api.json
COMFY_MAPPING=./workflows/mapping.json
# reference-image workflow for outfits/expressions (Qwen-Image-Edit 2511); "off" disables it
# fp8 (19 GB) beats the Q4_K_M GGUF on a 16 GB RTX 50 card: ~40 s vs ~73 s per edit. Run ComfyUI with
# --fast-disk --cache-ram 6 --reserve-vram 1, or its pinned-RAM staging pages the whole PC out (freezes).
COMFY_REF_WORKFLOW=./workflows/ref_edit.api.json
COMFY_REF_MAPPING=./workflows/ref_mapping.json
IMAGE_STYLE_PREFIX=pixel art, 16-bit retro game art, clean pixel clusters, limited pastel palette, soft lighting, reality show still
SEASON_LENGTH=0         # 0 = open ended; wrap the season after at least 3 episodes
LLM_CALLS_PER_SLOT=6
# per rendered scene (beats, lines, voice retries, outcome, commentary)
LLM_CALLS_PER_SCENE=8
SEED=
LANGUAGE=en
PORT=8787
DATA_DIR=./data         # saves + event log (the e2e tests point this at a throwaway dir)
# optional tuning
LLM_TIMEOUT_MS=90000
FLAVOR_PASS=0           # 1 = let the LLM rewrite scene premises (costs budget)
IMAGE_TIMEOUT_MS=180000
TEMP_DIALOGUE=0.9
TEMP_BEATS=0.7
TEMP_DELTAS=0.2
TEMP_COMMENTARY=0.9
# unload the resident LLM before each ComfyUI job (one 16 GB GPU); 0 if the card fits both
FREE_LLM_FOR_IMAGES=1
