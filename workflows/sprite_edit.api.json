{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux-2-klein-base-4b-fp8.safetensors",
      "weight_dtype": "default"
    }
  },
  "lora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "lora_name": "pixel_4walk_small_flux2_klein_base_4b_v1.safetensors",
      "strength_model": 1.0
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen_3_4b.safetensors",
      "type": "flux2",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "flux2-vae.safetensors"
    }
  },
  "ref": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "portrait.png"
    }
  },
  "refs": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": {
      "image": [
        "ref",
        0
      ],
      "upscale_method": "nearest-exact",
      "megapixels": 1,
      "resolution_steps": 1
    }
  },
  "refl": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "refs",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "p": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "Create a pixel art spritesheet of the character in the image. The spritesheet is a 4 by 4 grid of four rows of frames - first row is 3 walking frames facing down and 1 frame both arms raised, second row is 3 walking frames facing left and 1 frame jumping left, third row is 3 walking frames facing right and 1 frame jumping right, fourth row is 3 walking frames back view facing up and 1 frame lying on floor."
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": ""
    }
  },
  "latent": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "sched": {
    "class_type": "Flux2Scheduler",
    "inputs": {
      "steps": 20,
      "width": 512,
      "height": 512
    }
  },
  "sampler": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "noise": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 0
    }
  },
  "pr": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "p",
        0
      ],
      "latent": [
        "refl",
        0
      ]
    }
  },
  "nr": {
    "class_type": "ReferenceLatent",
    "inputs": {
      "conditioning": [
        "neg",
        0
      ],
      "latent": [
        "refl",
        0
      ]
    }
  },
  "guider": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "lora",
        0
      ],
      "positive": [
        "pr",
        0
      ],
      "negative": [
        "nr",
        0
      ],
      "cfg": 5
    }
  },
  "k": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "noise",
        0
      ],
      "guider": [
        "guider",
        0
      ],
      "sampler": [
        "sampler",
        0
      ],
      "sigmas": [
        "sched",
        0
      ],
      "latent_image": [
        "latent",
        0
      ]
    }
  },
  "sheet": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "k",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "sheet_save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "sheet",
        0
      ],
      "filename_prefix": "shared_roof_sprite"
    }
